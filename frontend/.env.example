```text
# Base URL of the FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8002

# Role ID for Admin
VITE_ADMIN_ROLE_ID=1

# Role ID for normal User
VITE_USER_ROLE_ID=2

# Maximum file size in bytes
# Mirrors MAX_FILE_SIZE from the backend
# Used only for client-side pre-validation
VITE_MAX_FILE_SIZE=92274688
```
